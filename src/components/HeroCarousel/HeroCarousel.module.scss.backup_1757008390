// Hero Carousel styles - inspired by how-it-works page
@use '../../styles/variables' as *;

.heroCarousel {
  position: relative;
  height: 100vh;
  min-height: 600px;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.heroBackground {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-size: cover;
  background-position: center center;
  background-repeat: no-repeat;
  opacity: 0;
  transition: opacity 1s ease-in-out;
  
  &.active {
    opacity: 1;
  }
}

.heroOverlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(33, 69, 111, 0.9) 0%, rgba(33, 69, 111, 0.7) 100%);
  z-index: 1;
}

.heroContainer {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 2rem;
  position: relative;
  z-index: 2;
  width: 100%;
}

.heroContent {
  text-align: center;
  max-width: 800px;
  margin: 0 auto;
}

.heroTitle {
  font-size: 3.5rem;
  font-weight: 800;
  color: white;
  line-height: 1.1;
  margin-bottom: 1.5rem;
  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  
  @media (max-width: 768px) {
    font-size: 2.5rem;
  }
  
  @media (max-width: 480px) {
    font-size: 2rem;
  }
}

.heroAccent {
  color: $secondary-color;
  background: linear-gradient(135deg, $secondary-color, lighten($secondary-color, 10%));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: inline-block;
}

.heroSubtitle {
  font-size: 1.25rem;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
  margin-bottom: 2.5rem;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  
  @media (max-width: 768px) {
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }
}

.heroButtons {
  display: flex;
  gap: 1rem;
  justify-content: center;
  align-items: center;
  margin-bottom: 2rem;
  
  @media (max-width: 768px) {
    flex-direction: column;
    gap: 0.75rem;
  }
}

.primaryButton {
  background: $secondary-color;
  color: $dark-color;
  border: none;
  padding: 1rem 2rem;
  border-radius: 8px;
  font-weight: 600;
  font-size: 1.1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
  box-shadow: 0 4px 12px rgba(223, 244, 110, 0.3);
  
  &:hover {
    background: darken($secondary-color, 8%);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(223, 244, 110, 0.4);
  }
  
  @media (max-width: 768px) {
    width: 100%;
    justify-content: center;
  }
}

.secondaryButton {
  background: transparent;
  color: white;
  border: 2px solid rgba(255, 255, 255, 0.3);
  padding: 1rem 2rem;
  border-radius: 8px;
  font-weight: 600;
  font-size: 1.1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  backdrop-filter: blur(10px);
  
  &:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-2px);
    color: white;
    text-decoration: none;
  }
  
  @media (max-width: 768px) {
    width: 100%;
    justify-content: center;
  }
}

.buttonIcon {
  transition: transform 0.3s ease;
}

.primaryButton:hover .buttonIcon,
.secondaryButton:hover .buttonIcon {
  transform: translateX(2px);
}

.heroStats {
  margin-top: 2rem;
}

.heroStatsText {
  color: rgba(255, 255, 255, 0.8);
  font-size: 1rem;
  margin: 0;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  
  strong {
    color: white;
    font-weight: 600;
  }
}

.statHighlight {
  color: $secondary-color;
  font-weight: 600;
}

// Global styles for stat highlighting in carousel
:global(.stat-highlight) {
  color: $secondary-color;
  font-weight: 600;
}

// Carousel Controls
.carouselControls {
  position: absolute;
  top: 50%;
  width: 100%;
  display: flex;
  justify-content: space-between;
  padding: 0 2rem;
  z-index: 3;
  transform: translateY(-50%);
  
  @media (max-width: 768px) {
    display: none; // Hide on mobile for cleaner look
  }
}

.carouselButton {
  background: rgba(255, 255, 255, 0.2);
  border: none;
  border-radius: 50%;
  width: 50px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  cursor: pointer;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
  
  &:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.1);
  }
  
  svg {
    width: 20px;
    height: 20px;
  }
}

// Slide Indicators
.slideIndicators {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 0.75rem;
  z-index: 3;
}

.indicator {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: none;
  background: rgba(255, 255, 255, 0.4);
  cursor: pointer;
  transition: all 0.3s ease;
  
  &.active {
    background: $secondary-color;
    transform: scale(1.2);
  }
  
  &:hover {
    background: rgba(255, 255, 255, 0.6);
  }
}

// Responsive Design
@media (max-width: 768px) {
  .heroCarousel {
    min-height: 500px;
    height: 80vh;
  }
  
  .heroContainer {
    padding: 0 1rem;
  }
  
  .slideIndicators {
    bottom: 1rem;
  }
}
