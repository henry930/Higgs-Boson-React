{
  "name": "react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd server && source venv/bin/activate && python manage.py runserver 8000",
    "dev:full": "concurrently \"cd server && source venv/bin/activate && python manage.py runserver 8000\" \"vite\"",
    "start": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:seed": "cd server && source venv/bin/activate && python migrate_data.py",
    "db:migrate": "cd server && source venv/bin/activate && python manage.py migrate",
    "db:generate": "cd server && source venv/bin/activate && python manage.py makemigrations",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:api": "vitest run src/test/api.test.ts",
    "test:components": "vitest run src/test/components/",
    "test:pages": "vitest run src/test/pages/",
    "test:routing": "vitest run src/test/routing.test.tsx",
    "test:env": "node scripts/test-environment.js",
    "test:all": "npm run test:env && npm run test:run",
    "test:quick": "./scripts/quick-test.sh",
    "test:comprehensive": "./scripts/run-all-tests.sh"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lexical/plain-text": "^0.34.0",
    "@lexical/react": "^0.34.0",
    "@lexical/rich-text": "^0.34.0",
    "@lexical/utils": "^0.34.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@mui/x-date-pickers": "^8.10.2",
    "@prisma/client": "^6.14.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@types/dompurify": "^3.0.5",
    "@uiw/react-md-editor": "^4.0.8",
    "dayjs": "^1.11.14",
    "dompurify": "^3.2.6",
    "gapi-script": "^1.2.0",
    "google-auth-library": "^10.3.0",
    "googleapis": "^158.0.0",
    "isomorphic-dompurify": "^2.26.0",
    "lexical": "^0.34.0",
    "prisma": "^6.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.8.1",
    "sass": "^1.90.0",
    "sqlite3": "^5.1.7",
    "tech-stack-icons": "^3.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  }
}
