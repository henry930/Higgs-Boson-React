{
  "name": "react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cd server && source venv/bin/activate && python manage.py runserver 8000",
    "dev:full": "concurrently \"cd server && source venv/bin/activate && python manage.py runserver 8000\" \"vite\"",
    "start": "vite preview",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:seed": "cd server && source venv/bin/activate && python migrate_data.py",
    "db:migrate": "cd server && source venv/bin/activate && python manage.py migrate",
    "db:generate": "cd server && source venv/bin/activate && python manage.py makemigrations"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@tinymce/tinymce-react": "^6.3.0",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.2.6",
    "isomorphic-dompurify": "^2.26.0",
    "jsdom": "^26.1.0",
    "prisma": "^6.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.8.1",
    "sass": "^1.90.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tsx": "^4.20.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2"
  }
}
