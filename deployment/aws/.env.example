# AWS Deployment Environment Configuration
# Copy this file to .env in the deployment/aws directory and fill in your values

# ======================
# REQUIRED ENVIRONMENT VARIABLES
# ======================

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Django Secret Key (generate with: openssl rand -base64 32)
SECRET_KEY=your_django_secret_key

# OpenAI API Key (for AI chat functionality)
OPENAI_API_KEY=your_openai_api_key

# ======================
# AWS CONFIGURATION
# ======================

# AWS Profile (optional, defaults to default profile)
# AWS_PROFILE=your_aws_profile

# AWS Region (optional, defaults to us-east-1)
# AWS_DEFAULT_REGION=us-east-1

# ======================
# DEPLOYMENT CONFIGURATION
# ======================

# Deployment stage (dev, staging, prod)
STAGE=dev

# AWS Region for deployment
REGION=us-east-1

# Project configuration
PROJECT_NAME=higgs-boson-consultancy

# ======================
# OPTIONAL CONFIGURATION
# ======================

# Custom domain settings (if you want to use your own domain)
# CUSTOM_DOMAIN=yourdomain.com
# CERTIFICATE_ARN=arn:aws:acm:region:account:certificate/certificate-id

# Lambda configuration
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY=512

# CloudFront configuration
CLOUDFRONT_PRICE_CLASS=PriceClass_100

# ======================
# NOTES
# ======================
# 1. Make sure to run 'aws configure' to set up your AWS credentials
# 2. Install Serverless Framework: npm install -g serverless
# 3. Install required plugins: serverless plugin install -n serverless-python-requirements
# 4. Test your Supabase connection before deployment
# 5. Make sure your Django SECRET_KEY is secure for production deployments
