// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Benefit {
  id          Int      @id @default(autoincrement())
  icon        String
  title       String
  description String
  order       Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("benefits")
}

model ProcessStep {
  id          Int      @id @default(autoincrement())
  number      String
  title       String
  description String
  order       Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("process_steps")
}

model Testimonial {
  id          Int      @id @default(autoincrement())
  quote       String
  authorName  String   @map("author_name")
  authorTitle String   @map("author_title")
  authorImage String?  @map("author_image")
  order       Int
  active      Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("testimonials")
}

model HeroSlide {
  id                    Int      @id @default(autoincrement())
  title                 String
  subtitle              String
  primaryButtonText     String   @map("primary_button_text")
  primaryButtonLink     String   @map("primary_button_link")
  secondaryButtonText   String   @map("secondary_button_text")
  secondaryButtonLink   String   @map("secondary_button_link")
  backgroundClass       String   @map("background_class")
  backgroundImage       String   @map("background_image")
  order                 Int
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("hero_slides")
}

model Page {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique  // URL slug like "article1", "about-us"
  content     String   // HTML content from WYSIWYG editor
  metaTitle   String?  @map("meta_title")
  metaDescription String? @map("meta_description")
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  authorName  String?  @map("author_name")
  coverImage  String?  @map("cover_image")
  excerpt     String?  // Short description
  tags        String?  // JSON array of tags
  viewCount   Int      @default(0) @map("view_count")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pages")
}

model Appointment {
  id            Int      @id @default(autoincrement())
  name          String
  email         String
  phone         String?
  company       String?
  service       String   // Type of service they're interested in
  preferredDate DateTime @map("preferred_date")
  preferredTime String   @map("preferred_time") // Time slot like "09:00-10:00"
  message       String?  // Additional message/requirements
  status        String   @default("pending") // pending, confirmed, completed, cancelled
  duration      Int      @default(60) // Duration in minutes
  meetingLink   String?  @map("meeting_link") // Zoom/Teams link if online
  notes         String?  // Internal notes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("appointments")
}
